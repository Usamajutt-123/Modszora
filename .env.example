# ─── Adsterra ───────────────────────────────────────────────────────────────
# All values below are OPTIONAL — with none of them set the site renders its
# dashed placeholder boxes and makes zero requests to any ad host.
# Set them in .env.local locally and in Vercel (Settings → Environment
# Variables) for Production + Preview. These are NEXT_PUBLIC_*, so changing
# them requires a redeploy.

# Banner host — identical for all five banner units on this account
NEXT_PUBLIC_ADSTERRA_DOMAIN=

# 728 × 90 — download page, above the content
NEXT_PUBLIC_ADSTERRA_KEY_LEADERBOARD=

# 300 × 250 — sidebars on download, blog and review pages
NEXT_PUBLIC_ADSTERRA_KEY_RECTANGLE=

# 160 × 600 — desktop sidebars on game and blog pages (skyscraper)
NEXT_PUBLIC_ADSTERRA_KEY_SIDEBAR=

# 468 × 60 — inside article content on game, download and review pages
NEXT_PUBLIC_ADSTERRA_KEY_IN_ARTICLE=

# 320 × 50 — replaces the 728×90 leaderboard below the md breakpoint
NEXT_PUBLIC_ADSTERRA_KEY_MOBILE=

# Native Banner — separate product, and note the DIFFERENT host
NEXT_PUBLIC_ADSTERRA_NATIVE_DOMAIN=
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=

# Social Bar — sticky bottom bar; every public page, not /admin
NEXT_PUBLIC_ADSTERRA_SOCIALBAR_SRC=

# Popunder — Monetag, fires on every download click. Hardcoded in
# apps/web/src/lib/popunder.ts (zone 272339), so there is nothing to set here.

# ─── Monetag (push notifications) ───────────────────────────────────────────
# Two halves, both required:
#   1. apps/web/public/sw.js — the service worker, committed and always served
#      from the site root. Inert on its own.
#   2. This zone id — gates the loader that registers the worker and shows the
#      permission prompt. Unset means zero requests to any Monetag host.
# The delivery host (5gvci.com) is hardcoded in both sw.js and lib/ads.ts
# because a service worker under public/ cannot read env vars — if Monetag
# ever reissues the tag, update BOTH files together.
NEXT_PUBLIC_MONETAG_ZONE_ID=
